# --- Serveur du jeu ---
# Port du jeu (interface + WebSocket). Ouvrez-le dans le pare-feu pour jouer en réseau local.
PORT=3100
HOST=0.0.0.0

# --- API Ollama (dossier ollama_api) ---
API_URL=http://127.0.0.1:3000
# Même valeur que API_TOKEN dans le .env de ollama_api. Ne quitte jamais le serveur du jeu.
API_TOKEN=
# Modèle Ollama du juge. Vide = premier modèle installé.
JUDGE_MODEL=hf.co/unsloth/gemma-4-26B-A4B-it-GGUF:UD-Q3_K_XL
# Délai maximum du verdict (inclut le chargement du modèle en VRAM)
JUDGE_TIMEOUT_MS=180000
# Photos générées en fin de partie : both (les 2 plats), winner (le gagnant), none
IMAGE_MODE=both
# Taille des photos (multiple de 64, entre 512 et 1536)
IMAGE_SIZE=1024
# Délai maximum d'une photo, file d'attente de l'API comprise
IMAGE_REQUEST_TIMEOUT_MS=600000

# --- Règles ---
BUDGET_MIN=15
BUDGET_MAX=30
TOTAL_ROUNDS=16
MINIGAME_ROUND=7
MINIGAME_BONUS_MIN=5
MINIGAME_BONUS_MAX=10
# Mini-jeux tirés au sort, séparés par des virgules (vide = tous) :
# chop (découpe), memory (mémo), quiz (questions IA), hangman (pendu), reflex (réflexe), anagram (mots mélangés)
MINIGAMES=
# Jokers choisis par chaque joueur parmi les 9 proposés en début de partie (0 = pas de jokers)
JOKERS_PER_PLAYER=3
# Mode étoile : rounds d'enchères par manche (budget, mini-jeu et bonus suivent la même échelle)
STAR_ROUNDS=8
